MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=eov_playtest

# Generate a unique random value of at least 32 bytes for your private test setup.
# Use the SAME value for Authentication API and Persistent World service.
EOV_SESSION_SECRET=replace-with-a-private-random-secret-of-at-least-32-bytes

EOV_SESSION_TTL_SECONDS=86400
EOV_WORLD_DATABASE=./data/persistent-world.sqlite3
EOV_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# Optional: configure only for the private operator account in this local test world.
# EOV_OWNER_USER_ID=
