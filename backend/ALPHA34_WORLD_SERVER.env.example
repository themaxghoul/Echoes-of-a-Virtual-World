# Echoes of Virtuality Alpha 34 persistent world server
# Copy this file to .env locally. Never commit the copied file or the database.

# Use the same cryptographically random 32-byte-or-longer secret as the EoV
# authentication service. Do not reuse a game login password.
EOV_SESSION_SECRET=replace-with-the-same-random-secret-used-by-the-authentication-service

# UUID of the already-bound Luciferous creator account. A username is not authority.
EOV_OWNER_USER_ID=replace-with-the-bound-creator-user-uuid

# Persistent Alpha 34 world database path, relative to the server directory.
EOV_WORLD_DATABASE=.\data\persistent-world.sqlite3

# Origins allowed to read the world server. Keep `null` for the packaged desktop client.
EOV_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,null
